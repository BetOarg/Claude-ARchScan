       - name: Verify Dart formatting on changed files
         shell: bash
         run: |
           set -euo pipefail
           if [ "${{ github.event_name }}" = "pull_request" ]; then
-            base_ref="origin/${{ github.base_ref }}"
-            files="$(git diff --name-only "$base_ref"...HEAD -- '*.dart')"
+            base="$(git merge-base "origin/${{ github.base_ref }}" HEAD)"
           else
-            files="$(git diff-tree --no-commit-id --name-only -r HEAD -- '*.dart')"
+            base="$(git rev-parse HEAD~1 2>/dev/null || true)"
           fi
-          files="$(printf '%s\n' "$files" | grep -v '^packages/room_scanner_core/test/plan_export_builder_test.dart$' || true)"
-          
+          if [ -z "$base" ]; then
+            echo "Sin commit base; se omite el control de formato."
+            exit 0
+          fi
+
+          files="$(git diff --name-only --diff-filter=AM "$base" HEAD -- '*.dart' \
+            | grep -v '\.g\.dart$' \
+            | grep -v '/l10n/generated/' || true)"
           if [ -z "$files" ]; then
-            echo "No changed production Dart files to format-check."
+            echo "No changed Dart files to format-check."
             exit 0
           fi
 
-          echo "Formatting changed files..."
-          echo "$files" | while IFS= read -r file; do
-            if [ -n "$file" ] && [ -f "$file" ]; then
-              dart format "$file" || true
+          is_formatted() {
+            dart format --output=none --set-exit-if-changed "$1" >/dev/null 2>&1
+          }
+
+          failed=0
+          while IFS= read -r file; do
+            [ -z "$file" ] && continue
+            [ -f "$file" ] || continue
+            if is_formatted "$file"; then
+              continue
+            fi
+            if git cat-file -e "$base:$file" 2>/dev/null; then
+              # Copia en el mismo directorio: mismo paquete, misma versión
+              # de lenguaje y, por lo tanto, mismo estilo de formato.
+              base_copy="${file%.dart}.__format_base__.dart"
+              git show "$base:$file" > "$base_copy"
+              if is_formatted "$base_copy"; then
+                echo "::error file=$file::Este cambio deja sin formatear un archivo que estaba formateado"
+                failed=1
+              else
+                echo "::warning file=$file::Archivo previamente sin formatear"
+              fi
+              rm -f "$base_copy"
+            else
+              echo "::error file=$file::Archivo nuevo sin formatear (dart format)"
+              failed=1
             fi
-          done
+          done <<< "$files"
+          exit "$failed"
 
       - name: Verify publication structure
         run: dart run packages/room_scanner_app/tool/verify_store_readiness.dart --strict
@@ -208,6 +240,22 @@ jobs:
         working-directory: packages/room_scanner_app
         run: flutter build appbundle --release
 
+      - name: Audit 16 KB native alignment
+        working-directory: packages/room_scanner_app
+        run: |
+          bash "$GITHUB_WORKSPACE/.github/scripts/audit_native_alignment.sh" \
+            build/app/outputs/bundle/release/app-release.aab \
+            build/alignment-audit
+
+      - name: Upload alignment report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: android-16kb-alignment
+          path: packages/room_scanner_app/build/alignment-audit/*.txt
+          if-no-files-found: ignore
+          retention-days: 7
+
   check-ios:
     name: Verify iOS Build
     needs: test-core
