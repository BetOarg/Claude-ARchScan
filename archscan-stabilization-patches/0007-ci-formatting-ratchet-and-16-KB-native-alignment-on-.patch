From 159b0c5e4ea6cffee0e668b3bbab764683d4efe3 Mon Sep 17 00:00:00 2001
From: Claude <claude@users.noreply.github.com>
Date: Sat, 26 Sep 2026 13:34:53 +0000
Subject: [PATCH 07/10] ci: formatting ratchet and 16 KB native alignment on
 every build

- Formatting: new Dart files must be formatted and modified files may not
  regress from formatted to unformatted. Previously the step ran
  'dart format ... || true' and never failed. Already-unformatted files
  only emit a warning, so functional changes are not mixed with mass
  reformatting.
- Extract the readelf-based 16 KB alignment audit into
  .github/scripts/audit_native_alignment.sh.
- CI runs the audit on the unsigned release AAB and uploads the report;
  release_android.yml reuses the same script.
---
 .github/scripts/audit_native_alignment.sh | 46 +++++++++++++++
 .github/workflows/ci.yml                  | 70 +++++++++++++++++++----
 .github/workflows/release_android.yml     | 21 +------
 3 files changed, 106 insertions(+), 31 deletions(-)
 create mode 100755 .github/scripts/audit_native_alignment.sh

diff --git a/.github/scripts/audit_native_alignment.sh b/.github/scripts/audit_native_alignment.sh
new file mode 100755
index 0000000..37e5f77
--- /dev/null
+++ b/.github/scripts/audit_native_alignment.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# Verifica que todas las bibliotecas nativas (.so) de un AAB o APK estén
+# alineadas a 16 KB (LOAD segments >= 0x4000), requisito de Google Play
+# para Android 15+.
+#
+# Uso: audit_native_alignment.sh <archivo.aab|archivo.apk> <directorio-reporte>
+set -euo pipefail
+
+artifact="${1:?Falta la ruta del AAB/APK}"
+report="${2:?Falta el directorio de reporte}"
+
+if [ ! -f "$artifact" ]; then
+  echo "::error::No existe $artifact"
+  exit 1
+fi
+
+mkdir -p "$report/native"
+case "$artifact" in
+  *.aab) pattern='base/lib/*/*.so' ;;
+  *.apk) pattern='lib/*/*.so' ;;
+  *) echo "::error::Formato no soportado: $artifact"; exit 1 ;;
+esac
+
+unzip -q -o "$artifact" "$pattern" -d "$report/native" || true
+find "$report/native" -type f -name '*.so' | sort > "$report/native-libraries.txt"
+
+if [ ! -s "$report/native-libraries.txt" ]; then
+  echo "::error::El artefacto no contiene bibliotecas nativas; revisar el build"
+  exit 1
+fi
+
+incompatible=0
+: > "$report/page-alignment-16kb.txt"
+while IFS= read -r library; do
+  relative="${library#"$report/native/"}"
+  alignments="$(readelf -lW "$library" | awk '$1 == "LOAD" { print $NF }')"
+  printf '%s: %s\n' "$relative" "$alignments" | tee -a "$report/page-alignment-16kb.txt"
+  for alignment in $alignments; do
+    if (( alignment < 0x4000 )); then
+      echo "::error::$relative usa alineación $alignment (< 0x4000)"
+      incompatible=1
+    fi
+  done
+done < "$report/native-libraries.txt"
+
+exit "$incompatible"
