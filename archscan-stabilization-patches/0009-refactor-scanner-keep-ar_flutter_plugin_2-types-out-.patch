 .../lib/scanner/ar/archscan_ar_session.dart   | 38 +++++++++++++
 .../lib/scanner/widgets/archscan_ar_view.dart | 45 +++++++++++-----
 .../lib/screens/ar_scanner_screen.dart        | 54 +++----------------
 4 files changed, 85 insertions(+), 62 deletions(-)
 create mode 100644 packages/room_scanner_app/lib/scanner/ar/archscan_ar_session.dart

