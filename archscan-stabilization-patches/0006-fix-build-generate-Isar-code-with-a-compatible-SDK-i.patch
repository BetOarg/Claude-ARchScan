diff --git a/.github/actions/isar-codegen/action.yml b/.github/actions/isar-codegen/action.yml
new file mode 100644
index 0000000..31ba10f
--- /dev/null
+++ b/.github/actions/isar-codegen/action.yml
@@ -0,0 +1,30 @@
+name: Isar code generation
+description: >
+  Genera isar_models.g.dart con un SDK de Flutter compatible con
+  isar_community_generator. Ver docs/ISAR_TOOLCHAIN.md.
+
+inputs:
+  flutter-version:
+    description: Versión de Flutter usada SOLO para generar código Isar.
+    required: false
+    default: "3.41.4"
+
+runs:
+  using: composite
+  steps:
+    - name: Set up Flutter for Isar codegen
+      uses: subosito/flutter-action@v2
+      with:
+        flutter-version: ${{ inputs.flutter-version }}
+        channel: stable
+        cache: true
+
+    - name: Generate Isar models (room_scanner_core)
+      shell: bash
+      working-directory: packages/room_scanner_core
+      run: |
+        set -euo pipefail
+        flutter --version
+        flutter pub get
+        dart run build_runner build --delete-conflicting-outputs
+        test -s lib/src/models/isar_models.g.dart
